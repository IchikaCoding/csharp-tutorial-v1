
@* ここで、Contextのレジデントが使えるようにモデルとして持ってくる *@
@model IEnumerable<MvcMovie.Models.Resident>

@* データ表示用のヘッダーとかテーブルを作成する *@

<table>
    <thead>
        <tr>
            @* とりあえずこうやって書くということだけわかった。 *@
            @* TODO: Htmlが何を意味しているのかわからなかった *@
            <th scope="col">@Html.DisplayNameFor(model => model.Name)</th>
            <th scope="col">@Html.DisplayNameFor(model => model.AnimalType)</th>
            <th scope="col">@Html.DisplayNameFor(model => model.Job)</th>
            <th scope="col">@Html.DisplayNameFor(model => model.ResidentSince)</th>
        </tr>
    </thead>
    <tbody>
        @* foreachとかで繰り返す数はデータに合わせる *@
        @* IDを指定して、テーブルから、1件ずつデータを取得 *@
        @foreach (Resident item in Model)
        {
            <tr>
                @* TODO: どうしてmodelが必要なのか、ラムダ式である必要があるのか、これは調べてみよう！ *@
                @* TModelのジェネリック引数がmodel。今回のViewなら、`IEnumerable<MvcMovie.Models.Resident>` *@
                @* ラムダ式の、右側は表示したいものたち。左側は、このViewの型を書くって理解になった *@
                @* TODO: どうしてcontentsでも型がResidentになってエラーもなく動くの？！😭😭 *@
                <td>@Html.DisplayFor(contents => item.Name)</td>
                <td>@Html.DisplayFor(model => item.AnimalType)</td>
                <td>@Html.DisplayFor(model => item.Job)</td>
                <td>@Html.DisplayFor(model => item.ResidentSince)</td>
            </tr>
            @* Console.WriteLine("item: ", item); *@
        }
    </tbody>
</table>