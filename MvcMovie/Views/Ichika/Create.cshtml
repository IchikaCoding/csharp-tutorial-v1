@* 先に作成したCreateを参考にして自分で書いてみよう！ *@

@model MvcMovie.Models.Resident

@{
    @* ViewDataはディクショナリ、そのTitleプロパティの値としてCreateを代入 *@
    ViewData["Title"] = "Create";
}

<h1>Create</h1>
@* TODO: actionは何を入れたらいいの？ *@
<form asp-action="Create" method="post">
    <span asp-validation-summary="ModelOnly" class="text-danger"></span>
    @* Name, AnimalType, Job, ResidentSince *@
    <div>
        <label asp-for="Name">お名前：</label>
        <input asp-for="Name">
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    @* AnimalType, Jobは、必須項目ではない！ *@
    <div>
        <label asp-for="AnimalType">動物の種類：</label>
        <select asp-for="AnimalType">
            <option value=""></option>
            <option value="human">Human</option>
            <option value="animal">Animal</option>
        </select>
        <span asp-validation-for="AnimalType" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Job">仕事：</label>
        <input asp-for="Job">
        <span asp-validation-for="Job" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="ResidentSince">住民登録日：</label>
        <input asp-for="ResidentSince">
        <span asp-validation-for="ResidentSince" class="text-danger"></span>
    </div>
    <div>
        @* inputタグか、buttonタグ、どっちがおすすめ？！ *@
        @* I'm here！！ *@
        <button type="submit" class="btn btn-primary">Submit</button>
    </div>
    @* ここにASP.NET Coreが自動生成してくれた偽造防止トークンがinput要素で表示される。
    このFormが送信されたら、偽造防止の検証をしてくれる。別サイトから、利用者の意図しない POST を送られる攻撃（CSRF）を防ぐ *@
</form>

@* ちょっと違うかも。。 *@
<a asp-action="Index">ホーム画面に戻る</a>