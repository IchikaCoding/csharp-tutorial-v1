@* この構文はRazor。@model ディレクティブ *@
@model MvcMovie.Models.Resident

@* TODO: 受け取ったデータをどうやって表示するのか？？ *@
@* BootstrapのCard形式で表示してみよう！ *@
@* カードを真ん中に配置 *@
<div class="d-flex justify-content-center">
<div class="card" style="width: 25rem;">
  <div class="card-body">
    @* 文字をセンターにしたい.mb-2は7pxくらい.mb-3は14px *@
    <h5 class="card-title mb-4 text-center">この項目を削除しますか？</h5>
    @* TODO: データ表示に適したDesignに修正 *@
    <dl class="row mb-4">
      <dt class="col-4">Name:</dt>
      <dd asp-for="Name" class="col-8 card-text ps-5">@Html.DisplayFor(model => model.Name)</ｄ>
      <dt class="col-4">AnimalType:</dt>
      <dd asp-for="AnimalType" class="col-8 card-text ps-5"> @Html.DisplayFor(model => model.AnimalType)</dd>
      <dt class="col-4">Job:</dt>
      <dd asp-for="Job" class="col-8 card-text ps-5">@Html.DisplayFor(model => model.Job)</dd>
      @* 列幅が狭くて2行になってしまった。だからtext-nowrapを実装して表示を調整しました♪ *@
      <dt class="col-4 text-nowrap">ResidentSince:</dt>
      <dd asp-for="ResidentSince" class="col-8 card-text ps-5">@Html.DisplayFor(model => model.ResidentSince)</dd>
    </dl>
    @* TODO: g-3の指定はどこで役立つ？👉️Gapか？！行の中の要素の隙間を開ける *@
    <div class="row g-3">
      @* TODO: ボタンは横並びがいい！ *@
      @* 条件とかあるならFormでGetメソッドで送ってもOK.
      今回は単純にページの遷移だけだから<a>のほうがシンプル *@
      <div class="col-6">
        <a asp-action="Index" class="btn btn-secondary w-100">戻る</a>
      </div>
      @* <form method="get">
        <input type="submit"  asp-action="Index" value="戻る">
      </form> *@
      <div class="col-6">
        <form method="post">
          @* input要素のsubmitならFormのPostリクエストが送られる！ *@
          <input type="submit" asp-action="DeleteConfirm" asp-route-id="@Model.Id" value="削除確定" class="btn btn-danger w-100">
          @* <a type="submit" asp-action="DeleteConfirm" asp-route-id="@Model.Id" class="card-link">Confirm</a> *@
        </form>
      </div>
    </div>
  </div>
</div>

</div>