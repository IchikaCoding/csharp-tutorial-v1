@* この構文はRazor。@model ディレクティブ *@
@model MvcMovie.Models.Resident

@* TODO: 受け取ったデータをどうやって表示するのか？？ *@
@* BootstrapのCard形式で表示してみよう！ *@
@* カードを真ん中に配置 *@
<div class="d-flex justify-content-center">
<div class="card" style="width: 18rem;">
  <div class="card-body">
    <h5 class="card-title">削除したい項目</h5>
    <p asp-for="Name" class="card-text">Name: @Html.DisplayFor(model => model.Name)</p>
    <p asp-for="AnimalType" class="card-text">AnimalType: @Html.DisplayFor(model => model.AnimalType)</p>
    <p asp-for="Job" class="card-text">Job: @Html.DisplayFor(model => model.Job)</p>
    <p asp-for="ResidentSince" class="card-text">ResidentSince: @Html.DisplayFor(model => model.ResidentSince)</p>
    @* TODO: asp-action=""がない！ *@
    @* TODO: CancelとDeleteでいいの？ *@
    <a asp-action="Index" class="card-link">戻る</a>
    @* Idを持ったまま本当の削除メソッドを実行する方法を考えてみよう！ヒント：Form *@
    @* TODO: idをここに入れる方法とは？ *@
    <a asp-action="DeleteConfirm" asp-route-id="@Model.Id" class="card-link">Confirm</a>
  </div>
</div>
@* RazorによってHTMLのオブジェクトを書き出す処理 *@
<p>@Html.DisplayFor(model => model.Id)</p>
@* 値を直接反映させる処理 *@
<p>@Model.Id</p>
</div>