@page
@model RazorPagesStudyLog.Pages.StudyLogs.StudyLogModel
@{
}

<div>
    <h1>いちかどんの学習記録</h1>
</div>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div>
        <div>
            @* これはC# のStudyLogModelクラスにBindPropertyするために必要 *@
            @* 👉️これをやったらFormに反映されるはず！ *@
            <label asp-for="StudyLogInput.Name">名前</label>
            <input asp-for="StudyLogInput.Name"/>
            <span asp-validation-for="StudyLogInput.Name" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="StudyLogInput.LearnedToday">今日学んだこと</label>
            <textarea asp-for="StudyLogInput.LearnedToday"></textarea>
            <span asp-validation-for="StudyLogInput.LearnedToday" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="StudyLogInput.UnderstandingLevel">理解度</label>
            <input asp-for="StudyLogInput.UnderstandingLevel"/>
            <span asp-validation-for="StudyLogInput.UnderstandingLevel" class="text-danger"></span>
        </div>
        <div>
            <input type="checkbox" asp-for="StudyLogInput.NeedsReview" />
            <label asp-for="StudyLogInput.NeedsReview">復習は必要ですか？</label>
            <span asp-validation-for="StudyLogInput.NeedsReview" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
    </div>
</form>